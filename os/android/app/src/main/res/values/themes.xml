<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Fullscreen" parent="LauncherTheme">
        <item name="android:windowFullscreen">true</item><item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/picker_bg</item><item name="android:colorAccent">#DFC28A</item>
        <item name="android:fontFamily">sans-serif-condensed</item><item name="android:textColorPrimary">#F4F1E8</item><item name="android:textColorSecondary">#AAA9A5</item>
        <item name="android:colorBackground">#151515</item><item name="android:colorControlHighlight">#334D4533</item>
        <item name="android:alertDialogTheme">@style/GameDialogTheme</item><item name="android:buttonStyle">@style/GameButtonStyle</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="GameDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#DFC28A</item><item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColorPrimary">#F4F1E8</item><item name="android:textColorSecondary">#AAA9A5</item>
        <item name="android:colorBackground">#151515</item><item name="android:windowBackground">@drawable/menu_panel</item><item name="android:buttonStyle">@style/GameButtonStyle</item>
    </style>
    <style name="GameButtonStyle" parent="android:Widget.Material.Button.Borderless">
        <item name="android:fontFamily">sans-serif-condensed</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">#DFC28A</item><item name="android:stateListAnimator">@null</item>
    </style>
</resources>
